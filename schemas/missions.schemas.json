{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fiche mission Mecanix",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "vehicule", "titre", "niveau", "type_capture", "duree_s", "materiel", "securite", "a_deposer", "pieces_attendues", "mire", "passes", "valide"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^M[0-9]{2}_[A-Za-z0-9_]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "vehicule": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "titre": { "type": "string", "minLength": 5, "maxLength": 80 },
    "niveau": { "type": "integer", "enum": [0, 1, 2] },
    "type_capture": { "type": "string", "enum": ["video", "photos"] },
    "duree_s": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 30 },
        "max": { "type": "integer", "maximum": 600 }
      }
    },
    "materiel": { "type": "array", "items": { "type": "string" } },
    "securite": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "a_deposer": { "type": "array", "items": { "$ref": "#/$defs/piece" } },
    "tutos_associes": { "type": "array", "items": { "type": "string" } },
    "pieces_attendues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/piece" } },
    "mire": {
      "type": "object",
      "required": ["obligatoire", "placement"],
      "properties": {
        "obligatoire": { "type": "boolean" },
        "placement": { "type": "string" }
      }
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "vue", "distance_cm", "consigne"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "vue": { "type": "string" },
          "distance_cm": { "type": "integer", "minimum": 5, "maximum": 500 },
          "consigne": { "type": "string" }
        }
      }
    },
    "exemple_video": { "type": ["string", "null"] },
    "valide": { "type": "boolean" }
  },
  "$defs": {
    "piece": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(_[A-Za-z0-9]+)*$",
      "description": "Identifiant de pieces.json, sans accents ni espaces (ex. Disque_AvG)"
    }
  }
}
